# Copy this file to  llm.env  and paste your own key.
# llm.env is read by start_all.ps1 and never committed anywhere.
#
# Free options, all OpenAI-compatible - pick one:
#
#   Groq      https://console.groq.com/keys        (fast, generous free tier)
#     PUBMED_API_BASE=https://api.groq.com/openai/v1
#     PUBMED_CLOUD_MODEL=llama-3.3-70b-versatile
#
#   Cerebras  https://cloud.cerebras.ai
#     PUBMED_API_BASE=https://api.cerebras.ai/v1
#     PUBMED_CLOUD_MODEL=llama-3.3-70b
#
#   OpenRouter https://openrouter.ai/keys
#     PUBMED_API_BASE=https://openrouter.ai/api/v1
#     PUBMED_CLOUD_MODEL=meta-llama/llama-3.3-70b-instruct:free

PUBMED_LLM=cloud
PUBMED_API_KEY=paste_your_key_here
PUBMED_API_BASE=https://api.groq.com/openai/v1
PUBMED_CLOUD_MODEL=llama-3.3-70b-versatile
