# Copy this file to  llm.env  and paste your own key.
# llm.env is read by start_all.ps1 and never committed anywhere.
#
# OpenAI-compatible providers can be used here. The recommended deployment is:
#
#   Groq      https://console.groq.com/keys
#     PUBMED_API_BASE=https://api.groq.com/openai/v1
#     PUBMED_CLOUD_MODEL=openai/gpt-oss-120b
#
# Cloud use is an explicit choice because the question and retrieved evidence
# passages leave the machine. The full corpus is never sent to the provider.

PUBMED_LLM=cloud
PUBMED_ALLOW_CLOUD=1
PUBMED_API_KEY=paste_your_key_here
PUBMED_API_BASE=https://api.groq.com/openai/v1
PUBMED_CLOUD_MODEL=openai/gpt-oss-120b
